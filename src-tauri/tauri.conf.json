{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zettlr",
  "version": "4.7.0",
  "identifier": "com.zettlr.desktop",
  "build": {
    "beforeDevCommand": "corepack yarn tauri:dev:frontend",
    "beforeBuildCommand": "corepack yarn tauri:build:frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zettlr",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icons/png/32x32.png",
      "../resources/icons/png/128x128.png",
      "../resources/icons/png/256x256.png",
      "../resources/icons/icon.ico",
      "../resources/icons/icon.icns"
    ]
  }
}
